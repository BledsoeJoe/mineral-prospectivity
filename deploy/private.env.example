# Private node. Copy to the repo root as .env and fill in.
COMPOSE_FILE=deploy/compose.private.yml

# Where runs are published; the public node reads the same prefix.
MPM_RUNS_ROOT=s3://your-bucket/mineral-prospectivity/runs
AWS_ENDPOINT_URL=https://us-east-1.linodeobjects.com
# AWS_REGION=us-east-1

# A read-write key scoped to the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

POSTGRES_PASSWORD=
# MPM_PROFILE=us-cu    # profile the one-shot pipeline builds on startup (default synth)

# CARTO basemap key for the operator console's build.
MAPS_API_KEY=
