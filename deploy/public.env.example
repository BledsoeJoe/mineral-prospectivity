# Public node. Copy to the repo root as .env and fill in.
COMPOSE_FILE=deploy/compose.public.yml

# The prefix the private node publishes to.
MPM_RUNS_ROOT=s3://your-bucket/mineral-prospectivity/runs
AWS_ENDPOINT_URL=https://us-east-1.linodeobjects.com
# AWS_REGION=us-east-1

# A read-only key scoped to the bucket; this node never writes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CARTO basemap key, baked into the frontend build.
MAPS_API_KEY=
